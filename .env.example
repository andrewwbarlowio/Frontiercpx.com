# Server-only: configure separately for Preview and Production. Never commit real values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ENQUIRY_CAPTURE_ENABLED=false
CONTACT_RATE_LIMIT_SECRET=
ENQUIRY_NOTIFICATION_TO=enquiries@frontiercpx.com
RESEND_API_KEY=
RESEND_FROM=Frontier <website@notifications.frontiercpx.com>
# Leave false while DKIM is pending. Capture still saves a durable notification queue.
CONTACT_NOTIFICATIONS_ENABLED=false
# Explicit opt-in needed to send from previews. Use a controlled test recipient there.
CONTACT_PREVIEW_NOTIFICATIONS_ENABLED=false
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
# Comma-separated exact preview/custom origins, only if not covered by VERCEL_URL.
CONTACT_ALLOWED_ORIGINS=
